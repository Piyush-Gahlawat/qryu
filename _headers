# Block access to sensitive paths (redundant if .assetsignore works, but safe)
/.git/*
  X-Robots-Tag: noindex
  Disallow: /

/wrangler.jsonc
  X-Robots-Tag: noindex
  Disallow: /

/worker.js
  X-Robots-Tag: noindex
  Disallow: /

# Global security headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';