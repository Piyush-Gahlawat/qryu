{
    "name": "shiryu-kit",
    "main": "./worker.js",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": [
            "/"
        ]
    }
}