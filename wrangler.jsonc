{
    "name": "shiryu-kit",
    "main": "./worker.js",
    "compatibility_date": "2026-11-01",
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        }
    },
    "ratelimits": [
        {
            "name": "GLOBAL_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 100,
                "period": 60
            }
        }
    ],
    "assets": {
        "directory": "./",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
    }
}